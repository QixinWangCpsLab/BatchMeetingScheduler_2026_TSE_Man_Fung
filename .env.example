# Copy to .env, or run run.bat and choose C.
# Choose E to create the containers from the current .env without prompting.
# DB_* is passed into the PHP container. Mail and site values are kept for the mailer and the /testwsqlnew base path.
# The current pages still use hardcoded Gmail settings and do not read MAIL_* yet.

PHP_CONTAINER_NAME=batch-meeting-scheduler-php
DB_CONTAINER_NAME=batch-meeting-scheduler-db
DB_NAME=testwsqlnew
DB_USER=appuser
DB_PASS=change_me_app_password
DB_ROOT_PASSWORD=change_me_root_password
DB_HOST=localhost
DB_DOCKER_HOST=db
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci
PHP_PORT=8080
TZ=Asia/Hong_Kong

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=ssl
MAIL_USER=
MAIL_PASS=
MAIL_FROM=gmail.com
MAIL_FROM_NAME=do-not-reply

ROOT_URL=http://localhost:8080
ROOT_PATH=/testwsqlnew
